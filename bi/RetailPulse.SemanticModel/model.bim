        "partitions": [
          {
            "name": "Segments",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = PostgreSQL.Database(\"localhost:5433\", \"retail_dwh_db\", [CreateNavigationProperties=false]),",
                "    Data = Source{[Schema=\"public\",Item=\"vw_bi_customer_segments\"]}[Data]",
                "in",
                "    Data"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Segment Customer Count",
            "expression": "IF(HASONEVALUE(Segments[run_id]), DISTINCTCOUNT(Segments[customer_key]))",
            "description": "IMPLEMENTED; DAX requires Desktop validation. SQL reference is verified separately."
          },
          {
            "name": "Median Recency",
            "expression": "IF(HASONEVALUE(Segments[run_id]), MEDIAN(Segments[recency]))",
            "description": "IMPLEMENTED; DAX requires Desktop validation. SQL reference is verified separately."
          },
          {
            "name": "Median Frequency",
            "expression": "IF(HASONEVALUE(Segments[run_id]), MEDIAN(Segments[frequency]))",
            "description": "IMPLEMENTED; DAX requires Desktop validation. SQL reference is verified separately."
          },
          {
            "name": "Median Monetary",
            "expression": "IF(HASONEVALUE(Segments[run_id]) && HASONEVALUE(Segments[currency]), MEDIAN(Segments[monetary]))",
            "description": "IMPLEMENTED; DAX requires Desktop validation. SQL reference is verified separately."
          },
          {
            "name": "Segment Monetary",
            "expression": "IF(HASONEVALUE(Segments[run_id]) && HASONEVALUE(Segments[currency]), SUM(Segments[monetary]))",
            "description": "IMPLEMENTED; DAX requires Desktop validation. SQL reference is verified separately."
          },
          {
            "name": "Segment Customer Share",
            "expression": "DIVIDE([Segment Customer Count], CALCULATE([Segment Customer Count], REMOVEFILTERS(Segments[cluster_id]), REMOVEFILTERS(Segments[cluster_name])))",
            "description": "IMPLEMENTED; DAX requires Desktop validation. SQL reference is verified separately."
          }
        ]
      },
