        "partitions": [
          {
            "name": "Inventory",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = PostgreSQL.Database(\"localhost:5433\", \"retail_dwh_db\", [CreateNavigationProperties=false]),",
                "    Data = Source{[Schema=\"public\",Item=\"vw_bi_inventory_status\"]}[Data]",
                "in",
                "    Data"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Last Known Stock",
            "expression": "SUM(Inventory[stock_on_hand])",
            "description": "IMPLEMENTED; DAX requires Desktop validation. SQL reference is verified separately."
          },
          {
            "name": "Verified Current Stock",
            "expression": "CALCULATE(SUM(Inventory[stock_on_hand]), Inventory[node_status] = \"ONLINE\", Inventory[data_status] = \"CURRENT\")",
            "description": "IMPLEMENTED; DAX requires Desktop validation. SQL reference is verified separately."
          },
          {
            "name": "Latest Snapshot Time",
            "expression": "MAX(Inventory[snapshot_time])",
            "description": "IMPLEMENTED; DAX requires Desktop validation. SQL reference is verified separately."
          },
          {
            "name": "Last Successful Update",
            "expression": "MAX(Inventory[last_successful_update])",
            "description": "IMPLEMENTED; DAX requires Desktop validation. SQL reference is verified separately."
          },
          {
            "name": "Inventory Age Hours",
            "expression": "MAX(Inventory[freshness_hours])",
            "description": "IMPLEMENTED; DAX requires Desktop validation. SQL reference is verified separately."
          },
          {
            "name": "Branch Collection Status",
            "expression": "SELECTEDVALUE(Inventory[node_status], \"Multiple / unknown\")",
            "description": "IMPLEMENTED; DAX requires Desktop validation. SQL reference is verified separately."
          }
        ]
