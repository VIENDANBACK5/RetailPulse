        "partitions": [
          {
            "name": "Sales",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = PostgreSQL.Database(\"localhost:5433\", \"retail_dwh_db\", [CreateNavigationProperties=false]),",
                "    Data = Source{[Schema=\"public\",Item=\"vw_bi_sales_analytics\"]}[Data]",
                "in",
                "    Data"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Gross Purchase Value",
            "expression": "IF(HASONEVALUE(Sales[currency]), SUM(Sales[gross_sales_amount]))",
            "description": "IMPLEMENTED; DAX requires Desktop validation. SQL reference is verified separately."
          },
          {
            "name": "Return Value",
            "expression": "IF(HASONEVALUE(Sales[currency]), SUM(Sales[refund_amount]))",
            "description": "IMPLEMENTED; DAX requires Desktop validation. SQL reference is verified separately."
          },
          {
            "name": "Cancellation Value",
            "expression": "IF(HASONEVALUE(Sales[currency]), SUM(Sales[cancellation_amount]))",
            "description": "IMPLEMENTED; DAX requires Desktop validation. SQL reference is verified separately."
          },
          {
            "name": "Net Sales",
            "expression": "IF(HASONEVALUE(Sales[currency]), SUM(Sales[net_sales_amount]))",
            "description": "IMPLEMENTED; DAX requires Desktop validation. SQL reference is verified separately."
          },
          {
            "name": "Order Count",
            "expression": "CALCULATE(DISTINCTCOUNT(Sales[order_identity]), Sales[transaction_type] = \"PURCHASE\")",
            "description": "IMPLEMENTED; DAX requires Desktop validation. SQL reference is verified separately."
          },
          {
            "name": "Quantity Sold",
            "expression": "CALCULATE(SUM(Sales[quantity]), Sales[transaction_type] = \"PURCHASE\")",
            "description": "IMPLEMENTED; DAX requires Desktop validation. SQL reference is verified separately."
          },
          {
            "name": "Average Order Value",
            "expression": "DIVIDE([Gross Purchase Value], [Order Count])",
            "description": "IMPLEMENTED; DAX requires Desktop validation. SQL reference is verified separately."
          },
          {
            "name": "Customer Count",
            "expression": "CALCULATE(DISTINCTCOUNT(Sales[customer_key]), Sales[transaction_type] = \"PURCHASE\", Sales[customer_code] <> \"GUEST\")",
            "description": "IMPLEMENTED; DAX requires Desktop validation. SQL reference is verified separately."
          }
        ]
      },
